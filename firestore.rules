// Firestore Security Rules for the Work Management System.
//
// Guiding principles:
//   - Every read or write requires an authenticated Firebase user (no public access).
//   - Users can only read and write their own documents unless they are admins.
//   - Admins (is_admin == true OR role == "admin") have elevated read/write access.
//   - Shared collections (tasks, projects, pipelines, kanban, activity, presence,
//     chat) are readable and writable by all authenticated users — the backend
//     API layer enforces finer-grained ownership rules.
//   - Sensitive fields (access_token, refresh_token, key_hash) are never readable
//     by clients; those fields only exist on the server via the Admin SDK.
//
// These rules are a baseline — they prevent unauthenticated access and
// cross-user writes to private data.  Authorization beyond "is authenticated"
// is enforced by the FastAPI backend, which verifies Firebase ID tokens.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnDocument(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Checks the calling user's own Firestore document for admin status.
      // Falls back to false if the document does not exist yet.
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        );
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Each user can read and write their own document.
    // Admins can read all user documents (for the admin panel).
    // No client can read access_token or refresh_token (server-only via Admin SDK).

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwnDocument(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwnDocument(userId);
      allow update: if isAuthenticated() && (
        isOwnDocument(userId) ||
        // Admins may update role/is_admin fields.
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Tasks ─────────────────────────────────────────────────────────────────
    // All authenticated users can read and write tasks.
    // The backend enforces finer ownership rules (e.g. assignee checks).

    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    // ── Activity log ──────────────────────────────────────────────────────────

    match /activity_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ── Projects ──────────────────────────────────────────────────────────────

    match /projects/{projectId} {
      allow read, write: if isAuthenticated();
    }

    // ── Pipelines ─────────────────────────────────────────────────────────────

    match /pipelines/{pipelineId} {
      allow read, write: if isAuthenticated();
    }

    // ── Kanban boards ─────────────────────────────────────────────────────────

    match /kanban_boards/{boardId} {
      allow read, write: if isAuthenticated();
    }

    // ── Calendar events ───────────────────────────────────────────────────────
    // Users can only read and write their own calendar events.

    match /calendar_events/{eventId} {
      allow read: if isAuthenticated() &&
        (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        resource.data.user_id == request.auth.uid;
    }

    // ── Role permissions ──────────────────────────────────────────────────────

    match /role_permissions/{permId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Bots / API keys ───────────────────────────────────────────────────────
    // Users can only see their own bots; key_hash is excluded by the API layer.

    match /bots/{botId} {
      allow read: if isAuthenticated() &&
        (resource.data.owner_id == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        (resource.data.owner_id == request.auth.uid || isAdmin());
    }

    // ── Share tokens ──────────────────────────────────────────────────────────

    match /share_tokens/{token} {
      // Share tokens are read by anyone who knows the token (public links).
      // Writes are restricted to the backend (Admin SDK bypasses these rules).
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ── File records ──────────────────────────────────────────────────────────

    match /file_records/{fileId} {
      allow read: if isAuthenticated() &&
        (resource.data.owner_id == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        (resource.data.owner_id == request.auth.uid || isAdmin());
    }

    // ── Presence ──────────────────────────────────────────────────────────────

    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isOwnDocument(userId);
    }

    // ── Chat rooms and messages ───────────────────────────────────────────────

    match /chat_rooms/{roomId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() &&
          (resource.data.sender_id == request.auth.uid || isAdmin());
      }
    }

    // ── Webhooks ──────────────────────────────────────────────────────────────

    match /webhooks/{webhookId} {
      allow read: if isAuthenticated() &&
        (resource.data.owner_id == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        (resource.data.owner_id == request.auth.uid || isAdmin());
    }

    // ── Custom roles ──────────────────────────────────────────────────────────

    match /custom_roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}