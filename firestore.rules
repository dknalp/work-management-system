rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request from the Firebase Admin SDK (server-side)?
    // Admin SDK bypasses all rules, so these rules govern direct client SDK access only.

    // Users: each user can read/write only their own profile.
    // is_admin and role fields are write-protected — only Admin SDK can set them.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && !('is_admin' in request.resource.data)
        && !('role' in request.resource.data);
      allow create: if false;  // Only backend creates user profiles
      allow delete: if false;
    }

    // Tasks: owner can CRUD their own tasks; read is scoped to owner.
    match /tasks/{taskId} {
      allow read: if request.auth != null
        && resource.data.owner_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.owner_id == request.auth.uid;
    }

    // Calendar events: owner only.
    match /calendar_events/{eventId} {
      allow read, write: if request.auth != null
        && resource.data.owner_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.owner_id == request.auth.uid;
    }

    // File records: owner only.
    match /file_records/{fileId} {
      allow read, write: if request.auth != null
        && resource.data.owner_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.owner_id == request.auth.uid;
    }

    // File shares: owner of the file or shared-with user can read.
    match /file_shares/{shareId} {
      allow read: if request.auth != null
        && (resource.data.owner_id == request.auth.uid
            || resource.data.shared_with_user_id == request.auth.uid);
      allow create, update, delete: if request.auth != null
        && resource.data.owner_id == request.auth.uid;
    }

    // Role permissions: read-only for authenticated users (backend manages writes).
    match /role_permissions/{permId} {
      allow read: if request.auth != null;
      allow write: if false;  // Backend (Admin SDK) only
    }

    // Custom roles: read-only for authenticated users.
    match /custom_roles/{roleId} {
      allow read: if request.auth != null;
      allow write: if false;  // Backend (Admin SDK) only
    }

    // Activity log: each user can read their own entries; backend writes.
    match /activity/{activityId} {
      allow read: if request.auth != null
        && resource.data.user_id == request.auth.uid;
      allow write: if false;  // Backend (Admin SDK) only
    }

    // All other collections: deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}