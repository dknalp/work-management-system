# =============================================================================
# WorkSync — Environment Variables
# =============================================================================
# Dokploy'da bu degerleri Project → Environment sekmesine gir.
# Local development icin bu dosyayi kopyala: cp .env.example .env
# =============================================================================

# -- ZORUNLU ------------------------------------------------------------------

# JWT imzalama anahtari — min 32 karakter, rastgele uret:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Frontend'in tam URL'i — CORS icin kullanilir
# Local: http://localhost:3051
# Production: https://app.yourdomain.com
FRONTEND_URL=http://localhost:3051

# Backend API'nin tam URL'i — Next.js build'e gomulur (build-time)
# Local: http://localhost:3052
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3052

# -- OPSIYONEL — Ilk kurulumda otomatik admin kullanici olustur --------------
# Yalnizca hic kullanici yokken (ilk deploy) calisir.
# Bos birakilirsa admin kullanici olusturulmaz — POST /auth/register ile kendin ekle.

# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=change_this_strong_password

# -- OPSIYONEL — PostgreSQL (docker-compose internal, genellikle degistirme) -

# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=workos

# -- OPSIYONEL — Token sureleri -----------------------------------------------

# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7

# -- OPSIYONEL — Cloudflare R2 (dosya yukleme icin) ---------------------------
# R2 ayarlanmazsa dosyalar container icinde tutulur (deploy'da silinir!)
# Production'da mutlaka ayarla.

# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=