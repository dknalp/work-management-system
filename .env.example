# ── Firebase ──────────────────────────────────────────────────────────────────
# Path to service account JSON file (mounted at runtime, never baked into image)
FIREBASE_SERVICE_ACCOUNT_JSON=/run/secrets/firebase-service-account.json
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# ── Google OAuth / Picker ─────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=your-picker-api-key

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-r2-public-url

# ── Application ───────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend-domain.com
APP_ENV=production
HMAC_SECRET=generate-with-openssl-rand-hex-32

# ── Admin seeding (first-run only, remove after seeding) ─────────────────────
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=change-me-immediately