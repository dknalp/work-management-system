# Firebase — required for all database and auth operations
# Set to a file path pointing to your service account JSON key:
#   FIREBASE_SERVICE_ACCOUNT_JSON=/path/to/serviceAccountKey.json
# Or set to the raw JSON string of the service account file:
#   FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# If unset, the SDK falls back to Application Default Credentials (ADC),
# which works inside Google Cloud environments.
FIREBASE_SERVICE_ACCOUNT_JSON=

FRONTEND_URL=http://localhost:3051

# Cloudflare R2 (optional — if unset, files are stored on local disk at frontend/data/)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
FILE_STORAGE_PATH=

# Google OAuth (optional — for Google Drive import)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=